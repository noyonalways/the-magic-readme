{
  "name": "the-magic-readme",
  "version": "1.1.0",
  "description": "A CLI tool to generate README files magically",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "the-magic-readme": "dist/bin/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "dev": "npm run build && node dist/bin/cli.js",
    "start": "node dist/bin/cli.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "README",
    "CLI",
    "generator",
    "readme-generator",
    "the-magic-readme",
    "readme-gen"
  ],
  "author": "Noyon Rahman",
  "license": "MIT",
  "files": [
    "LICENSE.md",
    "dist/",
    "templates/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noyonalways/the-magic-readme.git"
  },
  "bugs": {
    "url": "https://github.com/noyonalways/the-magic-readme/issues"
  },
  "homepage": "https://github.com/noyonalways/the-magic-readme",
  "dependencies": {
    "commander": "^12.0.0",
    "inquirer": "^8.0.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.17.0",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=16"
  }
}
